{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed reusable service authorization descriptor (not authority)",
  "description": "Review-only profile; current runtimes do not consume this descriptor. Instance registration and service/issuer trust are separate.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "secs.authorization-profile.proposal.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grant": {
          "const": "secs.holder-grant.v1"
        },
        "credential": {
          "const": "secs.holder-credential.v1"
        },
        "presentation": {
          "const": "secs.holder-presentation.v1"
        }
      },
      "required": [
        "grant",
        "credential",
        "presentation"
      ]
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "selector": {
            "const": "path_prefix.v1"
          },
          "node_kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "label",
          "description",
          "selector",
          "node_kinds"
        ]
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "resource": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "effect": {
            "enum": [
              "read",
              "write",
              "admin"
            ]
          },
          "scope_modes": {
            "type": "array",
            "items": {
              "enum": [
                "all",
                "paths"
              ]
            },
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true
          },
          "constraints_profile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "required": [
          "id",
          "label",
          "description",
          "resource",
          "effect",
          "scope_modes",
          "constraints_profile"
        ]
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "presets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "label",
          "operations"
        ]
      },
      "minItems": 0,
      "maxItems": 16,
      "uniqueItems": true
    },
    "onward_delegation": {
      "const": false
    }
  },
  "required": [
    "schema",
    "id",
    "revision",
    "display_name",
    "contracts",
    "resources",
    "operations",
    "presets",
    "onward_delegation"
  ]
}
